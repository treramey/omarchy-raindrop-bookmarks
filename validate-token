#!/bin/bash
set -euo pipefail

umask 077
export LC_ALL=C
max_token_bytes=8192
json=false
if [[ ${1:-} == --json ]]; then
  json=true
  shift
fi

report() {
  if [[ "$json" == true ]]; then
    # All strings are internal protocol literals, never token or server text.
    printf '{"status":"%s","code":"%s","retryAfterSeconds":%d}\n' "$1" "$2" "${3:-0}"
  fi
}

fail() {
  report "$1" "$2" "${4:-0}"
  printf '%s\n' "$3" >&2
  exit 1
}

if [[ ${1:-} == --file ]]; then
  [[ $# == 2 ]] || fail local arguments "Token validation received invalid arguments"
  token_path=$2
  [[ -f "$token_path" && -r "$token_path" ]] || fail local token-file "Raindrop token file is not readable"
  token_size=$(stat -Lc %s -- "$token_path" 2>/dev/null) || fail local token-file "Could not read the Raindrop token file"
  [[ "$token_size" =~ ^[0-9]+$ ]] || fail local token-file "Could not read the Raindrop token file"
  (( token_size > 0 )) || fail input empty "Raindrop token file is empty"
  # configure-token writes a final newline in addition to the token bytes.
  (( token_size <= max_token_bytes + 1 )) || fail input size "Raindrop token file has an invalid size"
  token=$(cat -- "$token_path") || fail local token-file "Could not read the Raindrop token file"
else
  [[ $# == 0 ]] || fail local arguments "Token validation received invalid arguments"
  token=""
  IFS= read -r -n $((max_token_bytes + 1)) token || [[ -n "$token" ]] \
    || fail input empty "Raindrop token was not provided"
  (( ${#token} <= max_token_bytes )) || fail input size "Raindrop token has an invalid size"
  if IFS= read -r -n 1 -t 0.2 extra; then
    fail input multiline "Raindrop token must be a single line"
  fi
fi

[[ -n "$token" ]] || fail input empty "Raindrop token cannot be empty"
(( ${#token} <= max_token_bytes )) || fail input size "Raindrop token has an invalid size"
[[ "$token" != *$'\r'* && "$token" != *$'\n'* ]] || fail input multiline "Raindrop token must be a single line"
command -v curl >/dev/null 2>&1 || fail local dependency "Token validation requires curl"

auth_header=""
response_headers=""
trap 'rm -f -- "$auth_header" "$response_headers"' EXIT
auth_header=$(mktemp) || fail local io "Could not prepare token validation"
response_headers=$(mktemp) || fail local io "Could not prepare token validation"
printf 'Authorization: Bearer %s\n' "$token" > "$auth_header" \
  || fail local io "Could not prepare token validation"
unset token

header_value() {
  awk -v key="$1" 'tolower($0) ~ "^" key ":" {
    sub(/^[^:]*:[[:space:]]*/, ""); sub(/[[:space:]]*$/, ""); value=$0
  } END { print value }' "$response_headers"
}

retry_seconds() {
  local raw reset deadline now seconds=60
  now=$(date +%s)
  raw=$(header_value retry-after)
  reset=$(header_value x-ratelimit-reset)
  if [[ "$raw" =~ ^[0-9]{1,9}$ ]]; then
    seconds=$((10#$raw))
  elif [[ -n "$raw" ]] && deadline=$(date -d "$raw" +%s 2>/dev/null); then
    seconds=$((deadline - now))
  elif [[ "$reset" =~ ^[0-9]{1,12}$ ]]; then
    seconds=$((10#$reset - now))
  fi
  (( seconds < 1 )) && seconds=1
  (( seconds > 86400 )) && seconds=86400
  printf '%d\n' "$seconds"
}

curl_status=0
http_status=$(curl -q --fail --silent --show-error \
  --proto '=https' --proto-redir '=https' --max-redirs 0 --noproxy '*' \
  --connect-timeout 5 --max-time 15 --max-filesize 1048576 \
  --header "@$auth_header" --output /dev/null \
  --dump-header "$response_headers" --write-out '%{http_code}' \
  --url 'https://api.raindrop.io/rest/v1/user') || curl_status=$?

case "$http_status" in
  401|403) fail auth rejected "Raindrop did not accept the token" ;;
  429) fail rate-limit http "Raindrop rate limit reached" "$(retry_seconds)" ;;
esac
case "$curl_status" in
  0) ;;
  28) fail timeout request "Raindrop token validation timed out" ;;
  63) fail service response-size "Raindrop token response exceeded the size limit" ;;
  23|26|27|43|48|126|127) fail local io "Could not run token validation" ;;
  22) fail service http "Raindrop could not complete token validation" ;;
  *) fail network connection "Could not connect to Raindrop" ;;
esac
[[ "$http_status" =~ ^2[0-9][0-9]$ ]] \
  || fail service response "Raindrop returned an unexpected token response"
report ok ""
