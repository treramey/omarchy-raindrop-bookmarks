#!/usr/bin/env python3
"""JSON boundaries for the local bookmark snapshot and cover metadata."""

import json
import math
import sys
from pathlib import Path


def reject_nonfinite_number(value):
    raise ValueError(f"invalid JSON number: {value}")


def read_json(path):
    with Path(path).open(encoding="utf-8") as source:
        return json.load(source, parse_constant=reject_nonfinite_number)


def write_json(value, output=sys.stdout):
    json.dump(value, output, ensure_ascii=True, separators=(",", ":"), allow_nan=False)
    output.write("\n")


def valid_bookmark_snapshot(snapshot, fingerprint, require_time):
    if not isinstance(snapshot, dict):
        return False
    version = snapshot.get("version")
    if type(version) not in (int, float) or version != 1:
        return False
    if snapshot.get("tokenFingerprint") != fingerprint:
        return False
    bookmarks = snapshot.get("bookmarks")
    if not isinstance(bookmarks, list) or not all(isinstance(item, dict) for item in bookmarks):
        return False
    if not require_time:
        return True
    synced_at = snapshot.get("syncedAt")
    if type(synced_at) is int:
        return synced_at >= 0
    return (type(synced_at) is float and math.isfinite(synced_at)
            and synced_at >= 0 and synced_at.is_integer())


def read_sync_state(path, fingerprint):
    try:
        state = read_json(path)
        if not isinstance(state, dict) or state.get("tokenFingerprint") != fingerprint:
            raise ValueError("different token")
        failure = state.get("failureCooldownUntil", 0)
        reset = state.get("rateLimitReset", 0)
        # Corrupt state must not become shell arithmetic or block future syncs.
        if not all(type(value) is int and 0 <= value <= 999999999999 for value in (failure, reset)):
            raise ValueError("invalid sync state")
        return failure, reset
    except (OSError, ValueError, TypeError, UnicodeError, RecursionError):
        return 0, 0


def cover_text(value):
    if value is None:
        return ""
    if isinstance(value, (dict, list)):
        return json.dumps(value, ensure_ascii=False, separators=(",", ":"))
    if value is True:
        return "true"
    if value is False:
        return "false"
    return str(value)


def cover_url(bookmark):
    cover = bookmark.get("cover")
    if cover is not None and cover != "":
        return cover_text(cover)
    media = bookmark.get("media")
    if isinstance(media, list) and media and isinstance(media[0], dict):
        return cover_text(media[0].get("link"))
    return ""


def escape_cover_tsv(value):
    # Match jq @tsv escaping. The URL guard still rejects escaped or unsafe URLs.
    return (value.replace("\\", "\\\\").replace("\0", "\\0")
            .replace("\t", "\\t").replace("\n", "\\n").replace("\r", "\\r"))


def cover_records(snapshot):
    for bookmark in snapshot["bookmarks"]:
        identifier = bookmark.get("_id")
        identifier = "null" if identifier is None else cover_text(identifier)
        url = cover_url(bookmark)
        sys.stdout.write(f"{escape_cover_tsv(identifier)}\t{escape_cover_tsv(url)}\n")


def main(args):
    command, *values = args
    if command == "read-state" and len(values) == 2:
        print(*read_sync_state(*values))
    elif command == "write-state" and len(values) == 4:
        fingerprint, failure, reset, output = values
        with open(output, "w", encoding="utf-8") as target:
            write_json({"version": 1, "tokenFingerprint": fingerprint,
                        "failureCooldownUntil": int(failure), "rateLimitReset": int(reset)}, target)
    elif command == "append-page" and len(values) == 3:
        response, records, per_page = values
        page = read_json(response)
        if not isinstance(page, dict) or not isinstance(page.get("items"), list):
            raise ValueError("invalid API response")
        items = page["items"]
        if not all(isinstance(item, dict) for item in items):
            raise ValueError("invalid API response")
        if len(items) > int(per_page):
            raise ValueError("API returned too many items")
        # Serialize before opening the records file so a bad page appends nothing.
        lines = [json.dumps(item, ensure_ascii=True, separators=(",", ":"), allow_nan=False) for item in items]
        with open(records, "a", encoding="utf-8") as target:
            target.writelines(line + "\n" for line in lines)
        print(len(items))
    elif command == "write-snapshot" and len(values) == 4:
        records, fingerprint, synced_at, output = values
        with open(records, encoding="utf-8") as source:
            bookmarks = [json.loads(line) for line in source]
        with open(output, "w", encoding="utf-8") as target:
            write_json({"version": 1, "tokenFingerprint": fingerprint,
                        "syncedAt": int(synced_at), "bookmarks": bookmarks}, target)
    elif command in ("load-snapshot", "cover-records") and len(values) == 2:
        snapshot = read_json(values[0])
        if not valid_bookmark_snapshot(snapshot, values[1], command == "load-snapshot"):
            raise ValueError("bookmark snapshot is missing, corrupt, or for another token")
        if command == "load-snapshot":
            write_json(snapshot)
        else:
            cover_records(snapshot)
    else:
        raise ValueError("invalid bookmark JSON command")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (OSError, ValueError, TypeError, UnicodeError, OverflowError, RecursionError) as error:
        print(f"bookmark JSON: {error}", file=sys.stderr)
        sys.exit(1)
