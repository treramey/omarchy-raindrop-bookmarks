#!/bin/bash
set -u
umask 077

plugin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
token_path=${1:-${RAINDROP_TOKEN_FILE:-$HOME/.config/raindrop/token}}
cover_dir=${2:-${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-shell/raindrop-bookmarks/covers}
snapshot_path=${3:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-shell/raindrop-bookmarks/bookmarks.json}
force=false
if [[ ${4:-} == --force ]]; then
  force=true
fi
stamp="$cover_dir/.last-sync"
url_guard="$plugin_dir/validate-cover-url"
thumbnail_source="$plugin_dir/cover-thumbnail.cpp"
refresh_seconds=300
parallel_downloads=4
max_new_covers_per_sync=100
max_cover_bytes=$((5 * 1024 * 1024))
max_image_memory_kib=$((256 * 1024))
cover_refresh_seconds=$((7 * 24 * 60 * 60))

emit_index() {
  [[ -d "$cover_dir" ]] || return 0
  while IFS= read -r -d '' path; do
    filename=${path##*/}
    id=${filename%%.*}
    [[ "$id" =~ ^[0-9]+$ ]] && printf '%s\t%s\n' "$id" "$path"
  done < <(find "$cover_dir" -maxdepth 1 -type f -name '*.png' -print0)
}

fail() {
  printf 'raindrop cover sync: %s\n' "$*" >&2
  emit_index
  exit 0
}

for command in curl file python3 timeout g++ pkg-config sha256sum flock; do
  command -v "$command" >/dev/null 2>&1 || fail "missing dependency: $command"
done
[[ -x "$url_guard" ]] || fail "URL guard is missing or not executable"
[[ -x "$plugin_dir/bookmark-json" ]] || fail "bookmark JSON helper is missing"
[[ -x "$plugin_dir/token-fingerprint" ]] || fail "token fingerprint helper is missing"
[[ -r "$thumbnail_source" ]] || fail "cover thumbnail source is missing"
pkg-config --exists Qt6Gui || fail "Qt6Gui development files are missing"

token_fingerprint=$("$plugin_dir/token-fingerprint" "$token_path" 2>/dev/null) \
  || fail "token is unavailable: $token_path"
[[ -f "$snapshot_path" && ! -L "$snapshot_path" && -r "$snapshot_path" ]] \
  || fail "bookmark snapshot is unavailable: $snapshot_path"
snapshot_size=$(stat -Lc %s -- "$snapshot_path" 2>/dev/null || echo 0)
[[ "$snapshot_size" =~ ^[0-9]+$ ]] || fail "could not read bookmark snapshot"
(( snapshot_size <= 50 * 1024 * 1024 )) || fail "bookmark snapshot is too large"

mkdir -p "$cover_dir"

# Compile the checked-in helper into the disposable cover cache on first use.
# Include the Qt version so package upgrades rebuild a matching binary. The
# plugin directory remains source-only for Omarchy validation and updates.
thumbnail_hash=$(sha256sum "$thumbnail_source" | cut -d ' ' -f 1)
qt_version=$(pkg-config --modversion Qt6Gui) || fail "could not read Qt6Gui version"
thumbnail_helper="$cover_dir/.cover-thumbnail-$qt_version-$thumbnail_hash"
build_thumbnail_helper() (
  flock -x -w 35 9 || return 1
  [[ -f "$thumbnail_helper" && ! -L "$thumbnail_helper" && -x "$thumbnail_helper" ]] && return 0
  local built
  built=$(mktemp "$cover_dir/.cover-thumbnail-build-XXXXXX") || return 1
  trap 'rm -f -- "$built"' EXIT
  local -a qt_flags
  read -r -a qt_flags <<< "$(pkg-config --cflags --libs Qt6Gui)" || return 1
  timeout --kill-after=2 30 g++ -std=c++17 -O2 -fPIC "$thumbnail_source" \
    "${qt_flags[@]}" -o "$built" || return 1
  chmod 700 "$built" || return 1
  mv -f -- "$built" "$thumbnail_helper"
) 9>"$cover_dir/.cover-thumbnail-build.lock"

if [[ "$force" != true && -f "$stamp" ]]; then
  now=$(date +%s)
  modified=$(stat -c %Y "$stamp" 2>/dev/null || echo 0)
  if (( now - modified < refresh_seconds )); then
    emit_index
    exit 0
  fi
fi

build_thumbnail_helper || fail "could not build Qt cover thumbnail helper"

records=$(mktemp)
"$plugin_dir/bookmark-json" cover-records "$snapshot_path" "$token_fingerprint" \
  > "$records" 2>/dev/null || {
  rm -f -- "$records"
  fail "bookmark snapshot is missing, corrupt, or for another token"
}

trap 'rm -f "$records"' EXIT

run_thumbnail() (
  # Bound the whole Qt decoder, including metadata, before it parses foreign data.
  local memory_limit_kib=$max_image_memory_kib
  local inherited_memory_kib
  inherited_memory_kib=$(ulimit -Sv) || return 1
  if [[ "$inherited_memory_kib" != unlimited ]]; then
    [[ "$inherited_memory_kib" =~ ^[0-9]+$ ]] || return 1
    if (( inherited_memory_kib < memory_limit_kib )); then
      memory_limit_kib=$inherited_memory_kib
    fi
  fi
  # The soft limit cannot exceed the inherited hard limit. Lower both to this
  # budget without raising either, and never parse if the limit cannot be applied.
  ulimit -v "$memory_limit_kib" || return 1
  ulimit -c 0 || return 1
  timeout --kill-after=2 10 "$thumbnail_helper" "$@"
)

sync_cover() {
  local id=$1
  local url=$2
  local target="$cover_dir/$id.png"
  local url_file="$cover_dir/$id.url"
  local download
  local converted
  local validated
  local host
  local address
  local canonical_url
  local resolve_address
  local mime
  local format
  local size
  local cached_url=""
  local modified
  local now

  [[ -n "$url" ]] || return 0
  validated=$("$url_guard" "$url" 2>/dev/null) || return 0
  IFS=$'\t' read -r host address canonical_url <<< "$validated"
  [[ -n "$host" && -n "$address" && -n "$canonical_url" ]] || return 0
  resolve_address="$host:443:$address"

  if [[ -f "$target" && ! -L "$target" && -s "$target" \
      && -f "$url_file" && ! -L "$url_file" ]]; then
    read -r cached_url < "$url_file" || cached_url=""
    now=$(date +%s)
    modified=$(stat -c %Y "$target" 2>/dev/null || echo 0)
    if [[ "$cached_url" == "$canonical_url" \
        && "$modified" =~ ^[0-9]+$ \
        && $((now - modified)) -lt $cover_refresh_seconds ]]; then
      return 0
    fi
  fi

  download=$(mktemp "$cover_dir/.download-$id-XXXXXX") || return 0
  converted="$download.png"

  if ! curl -q --fail --silent --show-error \
      --proto '=https' --proto-redir '=https' --max-redirs 0 --noproxy '*' \
      --resolve "$resolve_address" \
      --connect-timeout 3 --max-time 12 --speed-limit 1024 --speed-time 5 \
      --max-filesize "$max_cover_bytes" \
      --output "$download" --url "$canonical_url" 2>/dev/null; then
    rm -f "$download"
    return 0
  fi

  size=$(stat -c %s "$download" 2>/dev/null || echo 0)
  if [[ ! "$size" =~ ^[0-9]+$ ]] || (( size == 0 || size > max_cover_bytes )); then
    rm -f "$download"
    return 0
  fi

  mime=$(file --brief --mime-type "$download" 2>/dev/null)
  case "$mime" in
    image/png) format=png ;;
    image/jpeg) format=jpeg ;;
    image/gif) format=gif ;;
    image/webp) format=webp ;;
    *) rm -f "$download"; return 0 ;;
  esac

  if ! run_thumbnail "$format" "$download" "$converted" 2>/dev/null; then
    rm -f "$download" "$converted"
    return 0
  fi

  mv -f "$converted" "$target"
  printf '%s\n' "$canonical_url" > "$url_file.tmp"
  mv -f "$url_file.tmp" "$url_file"
  rm -f "$download"
}

active=0
new_covers=0
while IFS=$'\t' read -r id url; do
  [[ "$id" =~ ^[0-9]{1,20}$ ]] || continue
  [[ -n "$url" ]] || continue
  target="$cover_dir/$id.png"
  if [[ ! -f "$target" || -L "$target" || ! -s "$target" ]]; then
    (( new_covers >= max_new_covers_per_sync )) && continue
    ((new_covers++))
  fi
  sync_cover "$id" "$url" &
  ((active++))
  if (( active >= parallel_downloads )); then
    wait -n || true
    ((active--))
  fi
done < "$records"
wait

find "$cover_dir" -maxdepth 1 -type f -name '*.png' -mtime +30 -delete
find "$cover_dir" -maxdepth 1 -type f -name '*.url' -mtime +30 -delete
touch "$stamp"
emit_index
