#!/bin/bash
set -euo pipefail

umask 077

token_path=${1:-${RAINDROP_TOKEN_FILE:-$HOME/.config/raindrop/token}}
[[ "$token_path" == /* ]] || {
  echo "Raindrop token path must be absolute" >&2
  exit 1
}
token_dir=$(dirname -- "$token_path")
temporary_token=""

cleanup() {
  [[ -z "$temporary_token" ]] || rm -f -- "$temporary_token"
}
trap cleanup EXIT

IFS= read -r token || {
  echo "Raindrop token was not provided" >&2
  exit 1
}
[[ -n "$token" ]] || {
  echo "Raindrop token cannot be empty" >&2
  exit 1
}
[[ "$token" != *$'\r'* ]] || {
  echo "Raindrop token must be a single line" >&2
  exit 1
}
if IFS= read -r -t 0.2 extra_line; then
  echo "Raindrop token must be a single line" >&2
  exit 1
fi

if [[ ! -e "$token_dir" ]]; then
  install -d -m 700 -- "$token_dir"
elif [[ ! -d "$token_dir" ]]; then
  echo "Raindrop token parent is not a directory" >&2
  exit 1
fi
temporary_token=$(mktemp "$token_dir/.token-XXXXXX")
printf '%s\n' "$token" > "$temporary_token"
chmod 600 -- "$temporary_token"
mv -f -- "$temporary_token" "$token_path"
temporary_token=""
